ASPNETCORE_ENVIRONMENT=Development
Mongo__DatabaseUri=mongodb://mongodb:27017/?tls=false
PORT=8080

TracesNt__BaseUrl=${TRACES_NT_BASE_URL:-http://trade-tracesnt-stub:8080/mock/tracesnt/ws}

TracesNt__CustomsOfficeReferenceNumber=${TRACES_NT_CUSTOMS_OFFICE_REFERENCE_NUMBER:-XI000002}

TracesNt__Credentials__Default__Username=${TRACES_NT_CREDENTIALS_DEFAULT_USERNAME:-secret}
TracesNt__Credentials__Default__AuthenticationKey=${TRACES_NT_CREDENTIALS_DEFAULT_AUTHENTICATION_KEY:-secret}
TracesNt__Credentials__Default__WebServiceClientId=${TRACES_NT_CREDENTIALS_DEFAULT_WEB_SERVICE_CLIENT_ID:-secret}

TracesNt__Credentials__Customs__Username=${TRACES_NT_CREDENTIALS_CUSTOMS_USERNAME:-secret}
TracesNt__Credentials__Customs__AuthenticationKey=${TRACES_NT_CREDENTIALS_CUSTOMS_AUTHENTICATION_KEY:-secret}
TracesNt__Credentials__Customs__WebServiceClientId=${TRACES_NT_CREDENTIALS_CUSTOMS_WEB_SERVICE_CLIENT_ID:-secret}

# Cognito — for clients deployed outside CDP
AUTHENTICATION__COGNITO__AUTHORITY="http://localhost:8080/local/cognito"
AUTHENTICATION__COGNITO__SCOPE=<cognito-scope>

# STS — for CDP-internal services authenticating via IAM role
AUTHENTICATION__STS__AUTHORITY="http://localhost:8080/local/sts"
AUTHENTICATION__STS__AUDIENCE=trade-gateway